; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GN Paint"
config/version="v0.0.1.alpha"
run/main_scene="uid://cxo2vb7wrdllr"
config/auto_accept_quit=false
config/features=PackedStringArray("4.7", "Forward Plus")
run/low_processor_mode=true
run/delta_smoothing=false
config/icon="res://icon.svg"

[autoload]

GNp="*uid://dyvx1vplq0bq1"
GNpToolManager="*uid://bdwblg5rbmxr5"

[debug]

gdscript/warnings/unassigned_variable=0
gdscript/warnings/unassigned_variable_op_assign=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/unreachable_code=0
gdscript/warnings/unreachable_pattern=0
gdscript/warnings/standalone_expression=0
gdscript/warnings/standalone_ternary=0
gdscript/warnings/incompatible_ternary=0
gdscript/warnings/unsafe_void_return=0
gdscript/warnings/static_called_on_instance=0
gdscript/warnings/missing_tool=0
gdscript/warnings/redundant_static_unload=0

[display]

window/size/viewport_width=960
window/size/viewport_height=720
window/vsync/vsync_mode=0

[file_customization]

folder_colors={
"res://material/": "purple",
"res://resources/": "red",
"res://scenes/": "teal",
"res://scripts/": "blue",
"res://scripts/globals/": "purple",
"res://scripts/resources/": "red",
"res://scripts/ui/": "green"
}

