[sub_resource type="Shader" id="Shader_cisf0"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.7.1.stable's BlitMaterial.

shader_type texture_blit;
render_mode blend_mix;

uniform float smoothness : hint_range(0.0, 1.0, 0.001);
uniform int resolution : hint_range(1, 16000, 1); 

uniform sampler2D source_texture0 : hint_blit_source0;
uniform sampler2D source_texture1 : hint_blit_source1;
uniform sampler2D source_texture2 : hint_blit_source2;
uniform sampler2D source_texture3 : hint_blit_source3;

void blit() {
	float dist = length(UV-0.5);
	float sharpness = max(smoothness,2.0/float(resolution));
	float a = smoothstep(0.5, 0.5-sharpness*0.5, length(UV-vec2(0.5)));
	COLOR0 = vec4(1,1,1,a) * MODULATE;
}"

